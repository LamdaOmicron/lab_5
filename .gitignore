```gitignore
# Python cache files
__pycache__/
*.pyc
*.pyo
*.pyd

# Logs
*.log

# Environment files
.env
.env.local
*.env.*

# Dependencies
.venv/
venv/
pip-log.txt
pip-selfcheck.json

# Coverage reports
.coverage
coverage/
htmlcov/

# IDE specific
.vscode/
.idea/
*.swp
*.swo

# OS generated files
.DS_Store
Thumbs.db
```